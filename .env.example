# CrackSight AI — Backend Environment Configuration
# Copy this file to .env and fill in your own values.
# Never commit .env with real credentials to version control.

# =============================================================================
# Application
# =============================================================================
APP_NAME="CrackSight AI"
APP_ENV=development
DEBUG=false
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# =============================================================================
# CORS — Allowed Frontend Origins
# =============================================================================
# Comma-separated origins that browsers are allowed to call the backend from
# (Render static site, local dev server, etc.). Exact scheme+host, no
# trailing slash, no port wildcards, no "*". In production (DEBUG=false)
# this MUST contain the deployed frontend origin, e.g.:
#   ALLOWED_ORIGINS="https://cracksight-frontend.onrender.com"
# When unset in development (DEBUG=true), the local Vite dev-server origins
# (http://localhost:5173, http://127.0.0.1:5173) are permitted automatically.
# When unset in production, all cross-origin browser access is refused.
ALLOWED_ORIGINS="https://CHANGE_ME.example.com"

# =============================================================================
# Security
# =============================================================================
# Secret key for session signing and internal token operations.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY="CHANGE_ME_TO_A_RANDOM_SECRET_KEY"

# =============================================================================
# Authentication — Clerk
# =============================================================================
# Obtain from Clerk dashboard (https://dashboard.clerk.com).
CLERK_PUBLISHABLE_KEY="pk_test_CHANGE_ME"
CLERK_SECRET_KEY="sk_test_CHANGE_ME"
CLERK_JWT_ISSUER="https://CHANGE_ME.clerk.accounts.com"
# JWKS URL for JWT verification. Derived from issuer if not set:
# https://{CLERK_JWT_ISSUER}/.well-known/jwks.json
CLERK_JWKS_URL="https://CHANGE_ME.clerk.accounts.com/.well-known/jwks.json"

# =============================================================================
# Database — Neon PostgreSQL
# =============================================================================
# Obtain from Neon console (https://console.neon.tech).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?options
# Must include sslmode=require (Neon requires TLS for all client connections).
# The application validates this at startup and fails fast if missing.
DATABASE_URL="postgresql://CHANGE_ME:CHANGE_ME@CHANGE_ME.neon.tech:5432/CHANGE_ME?sslmode=require"

# Neon pooled vs direct endpoint: this application opens short-lived
# connections per operation and closes them immediately
# (src/crack_detection/backend/database.py:get_db_connection). It uses no
# prepared statements, LISTEN/NOTIFY, advisory locks, or temporary tables.
# This lifecycle is the textbook use case for Neon's pooled endpoint
# (PgBouncer transaction mode), which multiplexes many short-lived
# connections efficiently. Either endpoint works with psycopg2; the pooled
# endpoint is recommended. If using the pooled endpoint, the host will look
# like xxx-pooler.neon.tech instead of xxx.neon.tech.

# =============================================================================
# Object Storage — Cloudflare R2
# =============================================================================
# Obtain from Cloudflare dashboard (R2 section).
# The bucket must remain private; objects are accessed server-side only and
# never exposed publicly. The backend enforces ownership checks on all
# read/write operations.
#
# Setup steps (Cloudflare dashboard):
# 1. Create an R2 bucket (e.g. "cracksight-storage") — keep it private.
# 2. Create an R2 API token with "Object Read & Write" permissions, scoped to
#    this bucket where possible.
# 3. Set the variables below with the values from the dashboard. The endpoint
#    is account-specific: https://<account_id>.r2.cloudflarestorage.com
R2_ACCOUNT_ID="CHANGE_ME"
R2_ACCESS_KEY_ID="CHANGE_ME"
R2_SECRET_ACCESS_KEY="CHANGE_ME"
R2_BUCKET_NAME="CHANGE_ME"
R2_ENDPOINT="https://CHANGE_ME.r2.cloudflarestorage.com"

# R2 endpoint must be a valid HTTPS URL; the bucket name must be non-empty.
# The application validates these at startup and fails fast if missing or
# malformed. Never commit real credentials or the bucket name if it reveals
# account information.

# =============================================================================
# Inference Service (private, not exposed to end users)
# =============================================================================
INFERENCE_SERVICE_URL="http://localhost:8001"
INFERENCE_SERVICE_TIMEOUT=30
INFERENCE_CHECKPOINT_PATH="model_artifacts/m3_crack_seg_baseline_b1_20261026_201725/best_model.pth"
INFERENCE_IMAGE_SIZE="256,256"
INFERENCE_THRESHOLD=0.5
INFERENCE_DEVICE="cpu"

# =============================================================================
# Model Checkpoint — Render build-time download (Milestone 12, sub-deliverable 2)
# =============================================================================
# The trained U-Net ResNet-34 checkpoint is NOT committed to Git. At build time
# Render downloads it from a private Cloudflare R2 bucket using a pre-signed URL
# supplied here. The URL expires and must be refreshed whenever a future build
# needs a new download.
#
# Generate a pre-signed GET URL for the R2 object (Cloudflare dashboard, wrangler,
# or an R2 SDK with a short expiry), then set it in Render environment settings.
# Never commit a real URL, token, or signature to version control.
#   MODEL_CHECKPOINT_URL="https://CHANGE_ME.r2.cloudflarestorage.com/CHANGE_ME/best_model.pth?sig=CHANGE_ME"
MODEL_CHECKPOINT_URL="CHANGE_ME"

# Optional SHA-256 digest of the checkpoint file. When set, the build verifies
# the downloaded file against it and fails on mismatch. Compute it locally with:
#   sha256sum model_artifacts/m3_crack_seg_baseline_b1_20261026_201725/best_model.pth
#   MODEL_CHECKPOINT_SHA256="<64 hex chars>"
MODEL_CHECKPOINT_SHA256="CHANGE_ME"

# Destination path for the downloaded checkpoint. Must match the path the
# inference pipeline loads (INFERENCE_CHECKPOINT_PATH).
#   INFERENCE_CHECKPOINT_PATH="model_artifacts/m3_crack_seg_baseline_b1_20261026_201725/best_model.pth"
INFERENCE_CHECKPOINT_PATH="model_artifacts/m3_crack_seg_baseline_b1_20261026_201725/best_model.pth"

# =============================================================================
# File Upload Limits
# =============================================================================
# Maximum upload size in bytes (default 10 MB).
MAX_UPLOAD_SIZE_BYTES=10485760
# Maximum image dimension in pixels (width or height).
MAX_IMAGE_DIMENSION=4096
# Allowed image extensions.
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp

# =============================================================================
# Guest Session Limits
# =============================================================================
GUEST_MAX_ANALYSES_PER_SESSION=3
GUEST_SESSION_EXPIRATION_HOURS=24
REGISTERED_UNSAVED_EXPIRATION_HOURS=24
