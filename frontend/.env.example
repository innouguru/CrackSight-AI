# CrackSight AI — Frontend Environment Configuration
# Copy this file to .env and fill in your own values.
# Never commit .env with real credentials to version control.

# =============================================================================
# Authentication — Clerk
# =============================================================================
# Obtain from Clerk dashboard (https://dashboard.clerk.com).
# This key is safe to expose in the frontend.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_CHANGE_ME

# =============================================================================
# API — FastAPI Backend
# =============================================================================
# Local development backend URL.
VITE_API_URL=http://127.0.0.1:8000
